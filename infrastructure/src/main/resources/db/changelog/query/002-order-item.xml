<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002-create-order-item" author="sales-manager">
        <createTable tableName="order_item">
            <column name="id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="purchase_order_id" type="VARCHAR(255)">
                <constraints nullable="false" foreignKeyName="fk_order_item_purchase_order" references="purchase_order(id)"/>
            </column>
            <column name="catalog_offer_id" type="VARCHAR(255)"/>
            <column name="product_offer_id" type="VARCHAR(255)"/>
            <column name="name" type="VARCHAR(255)"/>
            <column name="price" type="JSONB"/>
            <column name="offer_validity" type="JSONB"/>
            <column name="offer_items" type="JSONB"/>
            <column name="metadata" type="JSONB"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
