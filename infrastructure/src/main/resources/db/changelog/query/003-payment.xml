<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="003-create-payment" author="sales-manager">
        <createTable tableName="payment">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="purchase_order_id" type="VARCHAR(255)">
                <constraints nullable="false" foreignKeyName="fk_payment_purchase_order" references="purchase_order(id)"/>
            </column>
            <column name="payment_method" type="JSONB"/>
            <column name="discount" type="JSONB"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
