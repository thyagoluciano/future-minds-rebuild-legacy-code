# Database
DB_URL=jdbc:postgresql://localhost:5432/sales_manager
DB_USERNAME=sales_manager
DB_PASSWORD=sales_manager

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Keycloak / OAuth2
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/realwave

# Application ports
COMMAND_APP_PORT=8080
QUERY_APP_PORT=8180
CONSUMER_APP_PORT=8082

# PostgreSQL (Docker)
POSTGRES_DB=sales_manager
POSTGRES_USER=sales_manager
POSTGRES_PASSWORD=sales_manager

# Zookeeper
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# Kafka broker
KAFKA_BROKER_ID=1
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true

# Multi-tenancy schema prefix
TENANT_SCHEMA_PREFIX=rw_sm_
